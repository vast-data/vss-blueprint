apiVersion: v1
kind: Secret
metadata:
  name: video-backend-secret
  namespace: NAMESPACE
type: Opaque
# Template only — copy to backend-secret.yaml (gitignored) and fill credentials.
stringData:
  config.yaml: |
    # VastDB Settings
    vdb_endpoint: "http://"
    vdb_bucket: "vss-db"
    vdb_schema: "vss-schema"
    vdb_collection: "vss-collection"
    vdb_prompts_collection: "vss-prompts-events"
    vdb_access_key: ""
    vdb_secret_key: ""
    
    # S3 Settings
    s3_endpoint: "http://"
    s3_access_key: ""
    s3_secret_key: ""
    s3_upload_bucket: "vss-chunks"
    s3_segments_bucket: "vss-chunks-segments"
    s3_region: "us-east-1"
    s3_use_ssl: false
    
    # -------------------------------------------------------------------------
    # Cosmos-Embed1 embedding endpoint. MUST match the ingest embedder
    # (same server = same vector space), or search returns garbage.
    #   Local NIM:      http host + port 8002, no authorization
    #   Routed gateway: https + "host/tenant/slot" + port 443 + bearer token
    #                   e.g. <gateway-host>/<tenant>/<embed-slot>
    # -------------------------------------------------------------------------
    embedding_local_nim: true
    embedding_host: ""
    embedding_port: 8002
    embedding_http_scheme: "http"
    embedding_authorization: ""   # optional Bearer token for hosted/routed embedding APIs (e.g. gateway)
    embedding_model: "nvidia/cosmos-embed1"
    embedding_dimensions: 256
    visual_embedding_model: "nvidia/cosmos-embed1"
    visual_embedding_dimensions: 256
    hybrid_text_weight: 0.6
    
    # -------------------------------------------------------------------------
    # Cosmos-Reason2 — search-answer / explore synthesis (text-only, no video).
    #   Local NIM:      http host + port 8001, cosmos_model nvidia/cosmos-reason2-8b
    #   Routed gateway: https + "host/tenant/slot" + port 443 + bearer token
    #                   e.g. <gateway-host>/<tenant>/<reason-slot>
    # -------------------------------------------------------------------------
    cosmos_host: ""
    cosmos_port: 8001
    cosmoshttpscheme: "http"
    cosmos_authorization: ""   # optional Bearer token for hosted/routed Cosmos-Reason2 APIs (e.g. gateway)
    cosmos_model: "nvidia/cosmos-reason2-8b"
    cosmos_temperature: 0.2
    synthesis_max_tokens: 2000
    synthesis_timeout_seconds: 120

    # -------------------------------------------------------------------------
    # NVIDIA API Key (required when embedding_local_nim is false)
    # -------------------------------------------------------------------------
    nvidia_api_key: "nvapi-xxx"
    
    # Upload Settings
    max_upload_size_mb: 100

    # UI timestamps (IANA timezone, e.g. Asia/Jerusalem, America/New_York, UTC)
    display_timezone: "UTC"
    
    # VAST VMS auth (user login validated via /api/token/)
    vast_host: ""
    tenant_name: "default"
    # jwt_secret MUST be a long random string (e.g. `openssl rand -hex 32`).
    # Backend refuses to start if empty. Reuse on upgrades or sessions invalidate.
    jwt_secret: ""
